APP_NAME=Immo-Prestige
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database: PostgreSQL (see docker-compose.yml) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=immo_prestige
DB_USERNAME=immo
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Queues, cache & broadcast on Redis (predis client, no C extension needed) ---
QUEUE_CONNECTION=redis
CACHE_STORE=redis
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Reverb (websockets) ---
REVERB_APP_ID=immo
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Local server process (php artisan reverb:start) binding, distinct from the
# public-facing REVERB_HOST/PORT/SCHEME above.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=http://localhost:5173

# SMTP reel. Sur Gmail, MAIL_PASSWORD est un *mot de passe d application*
# (Compte Google > Securite > Validation en deux etapes > Mots de passe des
# applications), pas le mot de passe du compte. Il expire quand la validation
# en deux etapes est reinitialisee : regenerez-le alors ici.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_ENCRYPTION=tls
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votre-adresse@gmail.com
MAIL_PASSWORD=votre-mot-de-passe-application
# Gmail impose que l expediteur soit le compte authentifie.
MAIL_FROM_ADDRESS="votre-adresse@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Frontend origin allowed by CORS ---
FRONTEND_URL=http://localhost:5173

# --- PayDunya (sandbox). Set PAYDUNYA_DRIVER=fake to stub locally. ---
PAYDUNYA_DRIVER=paydunya
PAYDUNYA_MODE=test
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=

# --- API docs (Scramble, /docs/api) ---
API_VERSION=v1
# Open outside APP_ENV=local only if you explicitly want the docs public
# (e.g. staging). Never flip this on in production without also gating it
# behind a proper auth mechanism.
API_DOCS_PUBLIC=false
