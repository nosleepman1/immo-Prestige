# Reachable from Expo Go without touching the LAN or the Windows firewall: the
# phone talks to ngrok, ngrok talks to the local server. Keep it in step with
# the backend's APP_URL.
EXPO_PUBLIC_API_URL=https://nonconverging-murmurously-madeline.ngrok-free.dev/api/v1

# Reverb (real-time) — the tunnel only forwards port 8000, so the websocket
# still needs the LAN address. Messaging falls back to polling off-network.
EXPO_PUBLIC_REVERB_APP_KEY=1gi0anmxy3cnfq57ylb5
EXPO_PUBLIC_REVERB_HOST=192.168.1.211
EXPO_PUBLIC_REVERB_PORT=8080
EXPO_PUBLIC_REVERB_SCHEME=http
