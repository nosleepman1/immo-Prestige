# Expo Go runs on the phone, so "localhost" would mean the phone itself, not the
# machine running the API. Put the dev machine's LAN address here (ipconfig ->
# IPv4 of the Wi-Fi adapter), and start the backend with --host=0.0.0.0 so it
# listens on that interface instead of the loopback only.
#
# On Windows, also allow inbound TCP 8000 through the firewall once, otherwise
# the phone's requests are dropped before PHP ever sees them.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api/v1

# Reverb (real-time messaging) — must match the backend's REVERB_* env vars.
# Same rule: the phone cannot reach "localhost".
EXPO_PUBLIC_REVERB_APP_KEY=local-key
EXPO_PUBLIC_REVERB_HOST=192.168.1.10
EXPO_PUBLIC_REVERB_PORT=8080
EXPO_PUBLIC_REVERB_SCHEME=http
