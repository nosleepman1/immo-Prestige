{
  "expo": {
    "name": "ImmoPrestige",
    "slug": "immo-prestige",
    "scheme": "immo-prestige",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f0f4ff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.immo.prestige"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f0f4ff"
      },
      "package": "com.immo.prestige"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store"
    ]
  }
}
